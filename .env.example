# ==============================================================================
# FRAMEWORK-SETISD-HC-UFPE: MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para um novo arquivo chamado '.env' na raiz do projeto.
# 2. Preencha os valores reais correspondentes ao seu ambiente (Desenvolvimento/Produção).
# 3. NUNCA comite o arquivo '.env' preenchido no Git (ele é ignorado via .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURAÇÕES DO SERVIDOR & AMBIENTE
# ------------------------------------------------------------------------------
# Qual o ambiente de execução? Opções: development, production
ENV=development

# Nível de log do sistema. Opções: debug, info, warning, error
LOG_LEVEL=info

# Domínios permitidos para requisições Cross-Origin (CORS), separados por vírgula.
# Use '*' apenas em desenvolvimento local. Em produção, especifique o domínio/IP ex: http://10.34.0.192
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. TRACEOPME — RASTREABILIDADE DE OPME (DOMÍNIO DE NEGÓCIO)
# ------------------------------------------------------------------------------
# Banco SQLite do TraceOPME (o mesmo arquivo da versão 17: pode apontar para o
# banco que já está em uso — as tabelas são criadas/migradas na inicialização).
OPME_DB=data/opme.db

# Pasta do log técnico (rotaciona a cada 2 MB). As cópias de segurança diárias
# do banco ficam em <pasta do banco>/backups.
OPME_LOG_DIR=logs

# Nome da instituição impresso nas etiquetas e PDFs
OPME_ORG="Hospital das Clínicas da UFPE"

# Login: tentativas erradas antes do bloqueio e minutos de bloqueio
OPME_TENTATIVAS=5
OPME_MINUTOS_BLOQUEIO=15

# Administrador criado no primeiro uso (banco vazio).
# Com o AD ligado, use em OPME_ADMIN o LOGIN DE REDE do administrador — ele entra
# com a senha da rede. A senha abaixo só vale enquanto o AD não estiver configurado.
OPME_ADMIN=admin
OPME_ADMIN_SENHA=TROQUE_ESTA_SENHA

# Alerta de validade (dias) e limite de uso do empenho que dispara o aviso (0 a 1)
OPME_DIAS_VALIDADE=90
OPME_LIMIAR_EMPENHO=0.8

# 1 = mostra a grade de caixas na tela da sala (padrão: 0)
OPME_GRADE_CAIXAS=0

# Agenda de procedimentos direto do relatórios (Metabase) — Procedimentos → Buscar no relatórios.
# Modelo 1703 = "Escala prévia definitiva" (http://relatorios.hc-ufpe.ebserh/model/1703-...).
METABASE_URL=http://relatorios.hc-ufpe.ebserh
# Usuário e senha de rede usados pela busca automática. O ideal é um usuário de
# serviço só com leitura do relatório. Em branco: a tela pede a senha a cada busca.
METABASE_USUARIO=
METABASE_SENHA=
AGENDA_MODELO=1703
# Coluna de data do modelo (em branco = escolhe sozinho, preferindo DTHR_INICIO_CIRG)
AGENDA_COLUNA_DATA=
# Rotina diária: 1 = busca sozinha nos horários abaixo (precisa de METABASE_USUARIO/SENHA)
AGENDA_AUTOMATICA=0
AGENDA_HORARIOS=06:00,12:00
# Dias de cada busca: 0 = hoje, 1 = amanhã (ex.: 0,1)
AGENDA_DIAS=0

# ------------------------------------------------------------------------------
# 3. BANCOS DE DADOS
# ------------------------------------------------------------------------------
# Banco de dados SQLite local da aplicação (armazena usuários autorizados e refresh tokens)
# Guardado na pasta data/ para manter a raiz limpa
APP_DB_URL=sqlite+aiosqlite:///data/app.db

# Bancos do AGHU: o TraceOPME não consulta o AGHU diretamente (importa a agenda
# e a planilha de lotes por arquivo). Deixe como está se não for usar.
# Banco de dados AGHU (PostgreSQL) - Preencha com a DSN do seu ambiente
POSTGRES_DSN=postgresql+asyncpg://usuario_exemplo:senha_exemplo@host_servidor:5432/nome_banco

# Banco de dados AGHU (Oracle) - Opcional se sua unidade utilizar Oracle
ORACLE_DSN=oracle+oracledb://usuario_exemplo:senha_exemplo@host_servidor:1521/nome_servico

# ------------------------------------------------------------------------------
# 4. AUTENTICAÇÃO CORPORATIVA (ACTIVE DIRECTORY / LDAP)
# ------------------------------------------------------------------------------
# Descomente e preencha a AD_URL em ambiente de produção na rede Ebserh.
# TraceOPME: com AD_URL preenchida, o login valida a senha de REDE no AD e o
# perfil (papel) continua no banco local do TraceOPME (RBAC). Sem AD_URL, vale a
# senha local do TraceOPME (modo de reserva, igual à versão 17).
# AD_URL=ldap://seu-servidor-ad.ebserhnet.ebserh.gov.br:389

# Árvore base para busca de usuários e grupos corporativos no AD
AD_BASEDN="DC=ebserhnet,DC=gov,DC=br"

# Opcional: Conta de serviço para busca de grupos no AD (se a consulta exigir privilégios)
AD_BIND_USER=EBSERHNET\usuario_servico_exemplo
AD_BIND_PASSWORD=senha_conta_servico_exemplo

# ------------------------------------------------------------------------------
# 5. SEGURANÇA E CRIPTOGRAFIA (JWT & COOKIES)
# ------------------------------------------------------------------------------
# Chave secreta usada para assinar os tokens JWT.
# ATENÇÃO: Altere para uma string aleatória forte em ambiente de produção!
JWT_SECRET=SUA_CHAVE_SECRETA_SUPER_FORTE_AQUI_ALTERAR_EM_PRODUCAO

# Tempo de expiração do Access Token (em horas) — 10 h cobre um plantão
JWT_EXP_HOURS=10

# Tempo de expiração do Refresh Token em Cookie HttpOnly (em dias)
REFRESH_TOKEN_EXP_DAYS=30

# Robô que lança a NF no AGHU (botão "Lançar no AGHU agora" na tela da NF).
# O robô fica no computador de quem lança (instalador na tela da NF); estes valores
# são enviados a ele. Homologação: http://10.34.0.64:8080/aghu/
AGHU_URL=http://10.34.0.64:8080/aghu/
# Navegador do computador: msedge (Edge) ou chrome
AGHU_NAVEGADOR=msedge
# v18.5 — robô no SERVIDOR (a tela do AGHU aparece dentro do TraceOPME).
# Navegador do servidor que o robô usa, sem janela: msedge (Edge instalado no
# servidor), chrome, ou vazio para o Chromium do Playwright.
AGHU_NAVEGADOR_SERVIDOR=msedge
# Quantos lançamentos ao mesmo tempo (cada um usa ~200-300 MB de memória).
AGHU_ROBO_MAX=3

# ---------------------------------------------------------------
# v18.4 — Cópia de segurança
# Todo dia, no horário BACKUP_HORA, o sistema copia o banco (data/opme.db) para
# data/backups (guarda BACKUP_MANTER cópias), confere a cópia e envia uma segunda
# cópia para BACKUP_PASTA_EXTERNA — uma pasta de rede FORA do servidor
# (ex.: \\servidor-arquivos\backup\traceopme ou Z:\backup\traceopme).
# A conta que roda o TraceOPME precisa ter permissão de escrita nessa pasta.
BACKUP_HORA=02:00
BACKUP_MANTER=30
BACKUP_PASTA_EXTERNA=
BACKUP_EXTERNO_MANTER=60
